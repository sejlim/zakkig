    "clsx": "^2.1.1",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "node-appwrite": "^27.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
