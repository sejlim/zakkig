# Appwrite Public Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://<REGION>.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="your_project_id_here"
NEXT_PUBLIC_APPWRITE_DATABASE_ID="webapp"

# Appwrite Server API Key (MANDATORY for backend operations like creating organizations)
# 1. Go to your Appwrite Console -> Select your Project
# 2. Scroll down to "API Keys" -> Create API Key
# 3. Give it following scopes:
#    - Database (documents.read, documents.write, collections.read, etc.)
#    - Users (users.read, users.write)
# 4. Paste the secret key below:
APPWRITE_API_KEY="your_api_key_here"

# Base URL for redirects (Password reset, emails, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3001"
