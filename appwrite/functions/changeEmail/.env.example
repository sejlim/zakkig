# Appwrite Public Configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://<REGION>.cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="your_project_id_here"

# Appwrite Server API Key
APPWRITE_API_KEY="your_api_key_here"

# App Base URL (for change email confirmation link)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Appwrite SMTP Provider IDs
APPWRITE_PROVIDER_ID_DE="your_de_provider_id_here"
APPWRITE_PROVIDER_ID_EN="your_en_provider_id_here"
